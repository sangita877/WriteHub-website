
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post | WriteHub</title>
    <link rel="stylesheet" href="/styles.css">
</head>
 <body>

    <nav class="navbar">
        <h1 class="logo">Write<span>Hub</span></h1>
        <a href="/" class="nav-btn">Home</a>
    </nav>

    <main class="container">

        <section class="section-heading">
            <p class="small-heading">UPDATE YOUR IDEAS</p>
            <h2>Edit Your Post</h2>
        </section>

        <form action="/edit/<%= post.id %>" method="POST" class="post-form">

            <label for="title">Post Title</label>

            <input
                type="text"
                id="title"
                name="title"
                value="<%= post.title %>"
                required
            >

            <label for="content">Your Thoughts</label>

            <textarea
                id="content"
                name="content"
                rows="10"
                required
            ><%= post.content %></textarea>

            <button type="submit" class="main-btn">
                Save Changes
            </button>

        </form>

    </main>

</body>
</html>
